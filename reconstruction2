            # 写入新 CSV
            out_refer = os.path.join(target_dir, 'refer_restructured.csv')
            with open(out_refer, 'w', encoding='utf-8-sig', newline='') as f:
                writer = csv.DictWriter(f, fieldnames=['源节点名称', '源节点标签', '关系类型', '目标节点名称', '目标节点标签', '知识分类', '页码', '核心释义'])
                writer.writeheader()
                writer.writerows(output_data)
                
            print(f"🎉 成功完成无损重构！共转换 {len(output_data)} 条数据（包括所有包含句中逗号的行）。")
            print(f"文件已保存至: {out_refer}")
            
        except Exception as e:
            print(f"❌ 处理 refer.csv 时发生内部错误: {e}")
